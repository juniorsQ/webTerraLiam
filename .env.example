# Copy to .env.local (never commit real keys).
# Same Supabase project as the Flutter game:
# https://ahlnxgtglibdbcialzbo.supabase.co
#
# Use the anon / publishable key only. Never put service_role here.

VITE_SUPABASE_URL=https://ahlnxgtglibdbcialzbo.supabase.co
VITE_SUPABASE_ANON_KEY=

# Maps JavaScript API for /ops. Restrict by HTTP referrer (localhost + dominio).
# Enable "Maps JavaScript API" in the same GCP project as the Flutter key.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Used only for docs/local notes. Password reset redirectTo uses
# window.location.origin at runtime (works on Vercel + localhost).
# VITE_SITE_URL=https://tu-proyecto.vercel.app
#
# Provider credits for /ops are read server-side from Supabase Vault
# (secrets FAL_KEY and RECRAFT_API_TOKEN). Never put those keys in this file.
